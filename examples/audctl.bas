10 REM POKEY AUDCTL MODES, CHANNEL 1 AND 2
20 SOUND 0,0,0,0:REM SKCTL=3, AUDCTL=0
30 F1=53760:C1=53761:F2=53762:C2=53763:F3=53764:C3=53765:AC=53768
40 PRINT "64 KHZ CLOCK":POKE AC,0:POKE C1,170:GOSUB 1000
50 PRINT "15 KHZ CLOCK (BIT 0)":POKE AC,1:GOSUB 1000
60 PRINT "1.79 MHZ CLOCK (BIT 6)":POKE AC,64:GOSUB 1000
70 PRINT "16-BIT CH1+CH2 (BITS 4,6)":POKE C1,0:POKE C2,170:POKE F1,0:POKE AC,80
80 FOR H=0 TO 255:POKE F2,H:FOR W=1 TO 2:NEXT W:NEXT H:POKE C2,0
90 PRINT "HIGH-PASS CH1 BY CH3 (BIT 2)":POKE AC,4:POKE C1,170:POKE C3,0:POKE F1,60
100 FOR P=0 TO 255:POKE F3,P:FOR W=1 TO 2:NEXT W:NEXT P
110 PRINT "17-BIT NOISE":POKE AC,0:POKE C1,138:GOSUB 1000
120 PRINT "9-BIT NOISE (BIT 7)":POKE AC,128:GOSUB 1000
130 PRINT "VOLUME ONLY (AUDC1 BIT 4)":POKE AC,0
140 FOR N=1 TO 50:FOR V=0 TO 15:POKE C1,16+V:NEXT V:NEXT N
150 POKE C1,0:SOUND 0,0,0,0:PRINT "DONE":END
1000 FOR P=0 TO 255:POKE F1,P:FOR W=1 TO 2:NEXT W:NEXT P:RETURN
