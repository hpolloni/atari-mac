10 GRAPHICS 0:POKE 82,0:POKE 752,1
20 X=20:Y=10:DX=1:DY=1:P=8:S=0
30 OX=X:OY=Y
40 J=STICK(0):IF J=14 AND P>1 THEN P=P-1:POSITION 1,P+4:? " ";
50 IF J=13 AND P<19 THEN P=P+1:POSITION 1,P-1:? " ";
60 FOR I=0 TO 3:POSITION 1,P+I:? "|";:NEXT I
70 X=X+DX:Y=Y+DY
80 IF Y<1 OR Y>22 THEN DY=-DY:Y=Y+2*DY
90 IF X>38 THEN DX=-DX:X=X+2*DX
100 IF X=2 AND Y>=P AND Y<=P+3 THEN DX=1:S=S+1
110 IF X<2 THEN POSITION 14,11:? "MISSED! SCORE ";S:FOR W=1 TO 600:NEXT W:GOTO 10
120 POSITION OX,OY:? " ";:POSITION X,Y:? "O";
130 POSITION 0,0:? "SCORE ";S;" ";
140 GOTO 30
